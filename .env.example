# Versand der Projektanfragen.
# Ohne diese beiden Werte weicht das Formular auf mailto aus,
# es geht also nichts verloren, es sieht nur weniger professionell aus.

# API-Key von https://resend.com
RESEND_API_KEY=

# Absenderadresse. Die Domain muss bei Resend verifiziert sein,
# sonst lehnt der Versand ab. Beispiel:
# ANFRAGE_ABSENDER="KLIX VISUALS <anfrage@klixvisuals.de>"
ANFRAGE_ABSENDER=
